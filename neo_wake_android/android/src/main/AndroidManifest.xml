<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Engine-independent native bootstrap (U8, KTD9). Runs before any
             Activity/Flutter engine, on every process start including a
             headless FGS restart — see NeoWakeStartup.kt. This provider's own
             onCreate is the ONLY process-start entry point; there is no
             neo_ble callback into this plugin (neo_ble must never depend on
             neo_wake — acyclic), so nothing is "also re-verified" elsewhere. -->
        <provider
            android:name="xyz.neosapien.neo_wake.NeoWakeStartup"
            android:authorities="${applicationId}.neo_wake_startup"
            android:exported="false"
            android:initOrder="1" />
    </application>
</manifest>
